# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback for lightweight testing)
# Example for PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/bug_diagnosis
DATABASE_URL=sqlite+aiosqlite:///./backend/bug_diagnosis.db

# Semantic Vector & RAG Policy
# SINGLE CENTRALIZED SIMILARITY THRESHOLDS (used across all agents and evaluations)
VECTOR_DIMENSION=384
DUPLICATE_THRESHOLD=0.82    # >= 0.82: Likely Duplicate
RELATED_THRESHOLD=0.65      # 0.65 - 0.81: Related Issue
WEAK_THRESHOLD=0.45         # 0.45 - 0.64: Weak Match
EVIDENCE_THRESHOLD=0.45     # Below 0.45: Insufficient historical evidence found

# LLM Provider Configuration
# Options: fallback (deterministic heuristic engine), ollama, gemini, openai
LLM_PROVIDER=fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Cloud LLM API Keys (leave empty to use local deterministic engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security Constraints
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_EXTENSIONS=[".txt", ".log", ".md", ".json"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]
