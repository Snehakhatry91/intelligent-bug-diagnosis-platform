{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://intelligent-bug-diagnosis-platform.onrender.com/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://intelligent-bug-diagnosis-platform.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://intelligent-bug-diagnosis-platform.onrender.com/health"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
